! =====================================================================
! Router0  -  Cisco 2901
! Gi0/0 -> Switch0 Gi0/1  (trunk 802.1Q, Router-on-a-Stick)
! Gi0/1 -> Switch4     (red de transito R5, 172.16.3.193/29)
! LAN propias: R1 Urgencias 172.16.2.0/25 y R2 Hospitalizacion 172.16.0.0/24
! =====================================================================
enable
configure terminal
hostname Router0
no ip domain-lookup
config-register 0x2102
! 0x2102 = arranque normal (lee la startup-config).
! Si quedara en 0x2142 (recuperacion de contrasena), el router IGNORARIA
! la configuracion guardada al reiniciar.
!
! ---------- Interfaz FISICA del trunk: sin IP, solo encendida ----------
interface GigabitEthernet0/0
 description TRUNK_A_SWITCH0
 no ip address
 no shutdown
 ! Al encender la fisica, se encienden tambien sus subinterfaces
exit
!
! ---------- Subinterfaz VLAN 210: gateway de R1 Urgencias 172.16.2.0/25 ----------
interface GigabitEthernet0/0.210
 encapsulation dot1Q 210
 ! dot1Q 210 -> esta subinterfaz atiende las tramas etiquetadas con VLAN 210
 ! (el numero despues del punto es solo convencion; lo que manda es dot1Q)
 ip address 172.16.2.1 255.255.255.128
 ! Esta IP es el GATEWAY que configuran los PCs de esa VLAN (primer host)
exit
!
! ---------- Subinterfaz VLAN 220: gateway de R2 Hospitalizacion 172.16.0.0/24 ----------
interface GigabitEthernet0/0.220
 encapsulation dot1Q 220
 ! dot1Q 220 -> esta subinterfaz atiende las tramas etiquetadas con VLAN 220
 ! (el numero despues del punto es solo convencion; lo que manda es dot1Q)
 ip address 172.16.0.1 255.255.255.0
 ! Esta IP es el GATEWAY que configuran los PCs de esa VLAN (primer host)
exit
!
! ---------- Interfaz de TRANSITO (red R5 compartida) ----------
interface GigabitEthernet0/1
 description R5_TRANSITO
 ip address 172.16.3.193 255.255.255.248
 ! /29 = 6 IP utiles; necesitamos 4 (una por router). /30 solo daria 2.
 no shutdown
exit
!
! ---------- RUTAS ESTATICAS hacia las 6 LAN remotas ----------
! Formato: ip route <red destino> <mascara> <siguiente salto>
! El siguiente salto es la IP de transito del router DUENO de esa LAN.
! No se agregan rutas a las 2 LAN propias ni a R5: son "conectadas" (C).
ip route 172.16.1.0 255.255.255.0 172.16.3.195
! -> R6 Consulta esta detras de Router2 (172.16.3.195)
ip route 172.16.2.128 255.255.255.128 172.16.3.195
! -> R7 Imagenes esta detras de Router2 (172.16.3.195)
ip route 172.16.3.0 255.255.255.192 172.16.3.194
! -> R3 Laboratorio esta detras de Router1 (172.16.3.194)
ip route 172.16.3.64 255.255.255.192 172.16.3.196
! -> R8 Administracion esta detras de Router3 (172.16.3.196)
ip route 172.16.3.128 255.255.255.224 172.16.3.194
! -> R4 Farmacia esta detras de Router1 (172.16.3.194)
ip route 172.16.3.160 255.255.255.224 172.16.3.196
! -> R9 Biomedica esta detras de Router3 (172.16.3.196)
!
end
copy running-config startup-config
!
! ---------- VERIFICACION ----------
! show ip interface brief   -> Gi0/0, Gi0/0.x (2) y Gi0/1 en up/up
! show ip route             -> 3 redes C + 6 rutas S
! show cdp neighbors        -> Gi0/0 -> su switch, Gi0/1 -> Switch4
! show version | include register  -> 0x2102
! ping 172.16.3.193 / .194 / .195 / .196   -> los 4 routers en R5
